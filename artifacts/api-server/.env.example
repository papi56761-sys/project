# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/krishisetu

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=pk_test_bmF0aW9uYWwtYnVubnktNjQwNy5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Google Gemini API Key for Crop Diagnosis triage (model: gemini-2.5-flash)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
